<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#1f2c33;">
<div style="max-width:1100px;margin:0 auto;padding:16px;">
{% block banner %}{% endblock %}
{% block heading %}
<h1 style="font-size:20px;margin:0 0 8px 0;">{% block title %}{% endblock %}</h1>
<p style="margin:0 0 12px 0;color:#5b6b75;font-size:12px;">Generated at {{ m.generated_at }} ({{ m.timezone }})</p>
{% endblock %}
{% if m.header %}<div style="margin:0 0 12px 0;white-space:pre-line;">{{ m.header }}</div>{% endif %}
{% block content %}{% endblock %}
{% if m.footer %}<div style="margin:16px 0 0 0;white-space:pre-line;">{{ m.footer }}</div>{% endif %}
<div style="margin:24px 0 0 0;padding:8px 0 0 0;border-top:1px solid #d6dadd;color:#7a8890;font-size:11px;">
{% if m.unsubscribe.url %}
To stop receiving this digest, <a href="{{ m.unsubscribe.url }}" style="color:#7a8890;">unsubscribe here</a>.
{% else %}
{{ m.unsubscribe.text }}
{% endif %}
</div>
</div>
</body>
</html>
