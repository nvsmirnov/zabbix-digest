# Settings for examples/docker-compose.yml with a real Zabbix and SMTP server.
# Copy to examples/.env (read by docker compose automatically) and keep it secret.

# Zabbix frontend URL (the API is <url>/api_jsonrpc.php).
ZABBIX_URL=https://zabbix.example.com

# SMTP server (used by Core only): digests, test messages, login links. SMTP_SECURITY: none, starttls or tls.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=zabbix-digest@example.com

# Address of the web UI as users open it; used in login and unsubscribe links.
PUBLIC_URL=http://localhost:8080
# Set to true when PUBLIC_URL is https.
COOKIE_SECURE=false

# Frontend administrators (impersonation), comma separated.
ADMIN_EMAILS=admin@example.com

# Link to user help in the UI (http/https). Empty: no link.
#HELP_URL=https://wiki.example.com/zabbix-digest

# Time zone of delivery times.
TZ=UTC

# Random secrets; generate with: openssl rand -hex 32
INTERNAL_API_KEY=
SESSION_SECRET=

# Trusted CA certificates for all TLS connections (Zabbix API, SMTP, Core <-> web).
# Empty: the certifi bundle shipped with Python packages (public CAs only).
# Debian/Ubuntu-based images: the system bundle, including CAs added with update-ca-certificates.
#SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
#SSL_CERT_DIR=

# Use proxies from the environment (HTTP_PROXY, HTTPS_PROXY, ALL_PROXY, NO_PROXY):
# PROXY_USE_INTERNAL for requests between Core and web, PROXY_USE_ZABBIX for the Zabbix API.
# With the demo Zabbix stub and a proxy in the environment, set PROXY_USE_ZABBIX=false.
#PROXY_USE_INTERNAL=false
#PROXY_USE_ZABBIX=true

# Image build (optional). Empty or unset: the defaults of the Dockerfiles.
# Base images of the Python runtime and of the UI build stage. The Python image must
# provide python3 with the venv module, or BUILD_EXTRA_CMD must install it.
#BASE_IMAGE_PYTHON=python:3.12-slim
#BASE_IMAGE_NODE=node:22-slim
# Shell commands run as root right after FROM (Python runtime stage, UI build stage).
# Example for an Ubuntu base image without Python:
#BUILD_EXTRA_CMD=export DEBIAN_FRONTEND=noninteractive; apt-get update && apt-get install -y python3 python3-venv && apt-get clean && rm -rf /var/lib/apt/lists/*
#BUILD_EXTRA_CMD_UI=
# Numeric user and group the services run as (e.g. to match volume permissions).
#APP_UID=10001
#APP_GID=10001
